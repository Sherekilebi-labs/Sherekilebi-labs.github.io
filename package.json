{
  "name": "sherekilebi-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "content:sync": "node scripts/prepare-content.mjs",
    "content:check": "node scripts/prepare-content.mjs --check",
    "assets:sync": "node scripts/sync-public-gitignore.mjs",
    "check": "tsc --noEmit && node scripts/validate-content.mjs",
    "build": "npm run check && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.8"
  }
}
